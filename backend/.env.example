# Application
NODE_ENV=development
PORT=4001

# Database
MONGODB_URI=your_mongodb_connection_string

# Authentication
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=1h

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email
SMTP_PASS=your_email_password

# Frontend
FRONTEND_URL=http://localhost:8080,https://nestleerp-search-api-frontend.vercel.app

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://nestleerp-search-api-frontend.vercel.app

# Swagger
API_BASE_URL=https://nestleerp-search-api.onrender.com/api-docs/

SUPER_ADMIN_BOOTSTRAP_KEY=replace-this-with-a-long-random-secret
ADMIN_LOGIN_URL=http://localhost:8080/frontend/pages/admin-login.html