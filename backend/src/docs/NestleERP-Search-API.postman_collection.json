        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const product = json?.data?.product || json?.product;",
                  "if (product?._id) {",
                  "  pm.collectionVariables.set('productId', product._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",

            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],

            "body": {
              "mode": "formdata",

              "formdata": [
                {
                  "key": "name",
                  "value": "Milo Chocolate Drink",
                  "type": "text"
