{
  "info": {
    "name": "nestleERP Backend API",
    "description": "Postman collection for the nestleERP backend API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check Backend Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "User Auth & Account",
      "item": [
        {
          "name": "Bootstrap Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-bootstrap-secret",
                "value": "your-bootstrap-secret"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPass1!\",\n  \"gender\": \"Male\",\n  \"location\": \"Lagos\",\n  \"phoneCountryCode\": \"+234\",\n  \"phone\": \"8012345678\",\n  \"address\": \"12 Main Street\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/bootstrap/super-admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "bootstrap", "super-admin"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"gender\": \"Female\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPass1!\",\n  \"location\": \"Abuja\",\n  \"phoneCountryCode\": \"+234\",\n  \"phone\": \"8098765432\",\n  \"address\": \"14 Unity Avenue\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password/forgot",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password", "forgot"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password", "verify-otp"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"resetToken\": \"replace-with-valid-reset-token\",\n  \"newPassword\": \"NewStrongPass1!\",\n  \"confirmPassword\": \"NewStrongPass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password", "reset"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"currentPassword\": \"StrongPass1!\",\n  \"newPassword\": \"NewStrongPass1!\",\n  \"confirmPassword\": \"NewStrongPass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/password/change",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "password", "change"]
            }
          }
        }
      ]
    },
